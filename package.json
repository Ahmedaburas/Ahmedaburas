{
  "name": "hse-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build --config client/vite.config.js",
    "check": "node --disable-warning=ExperimentalWarning server/check.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "vite": "^6.0.11"
  }
}
