# DARFIX env — copy to .env for local overrides. Never commit real secrets.
# Bind production secrets via Cursor secrets form (names below).
# Do not paste secret values into chat. Leave values empty here.

PORT=8787

# Required when NODE_ENV=production or DARFIX_REQUIRE_SECRET=1 (no fixed fallback in code).
# Local demo without this env generates an ephemeral per-process secret.
# DARFIX_SECRET=
# JWT_SECRET=  # accepted as alias for DARFIX_SECRET
# DARFIX_REQUIRE_SECRET=1

# Pilot/publish bootstrap (preferred): single admin from env — never hardcode passwords in source.
# Bind via Cursor secrets: DARFIX_ADMIN_EMAIL, DARFIX_ADMIN_PASSWORD
# DARFIX_ADMIN_EMAIL=
# DARFIX_ADMIN_PASSWORD=

# Local-only full demo dataset (customers/partners/bookings). Never enable on publish.
# DARFIX_SEED_DEMO=1
# DARFIX_DEMO_PASSWORD=   # required when DARFIX_SEED_DEMO=1; set in local shell/.env only

# Comma-separated emails allowed as Founding Partners (server-side only; signup body ignored).
# DARFIX_FOUNDING_EMAILS=

# Optional closed partner onboarding (comma-separated codes). When set, provider signup requires a match.
# DARFIX_PROVIDER_INVITE_CODES=

# Comma-separated browser origins for CORS. Production/pilot without this → same-origin only.
# DARFIX_CORS_ORIGINS=http://127.0.0.1:5173

DARFIX_TRIAL_DAYS=14
# DARFIX_PUBLIC_URL=

# Payments: omit MOYASAR_* to use mock checkout (local/dev smoke).
# DARFIX_PAYMENTS_PROVIDER=mock|moyasar
# Mock invoice pay + checkout simulate: on when payments=mock and no bound
# DARFIX_SECRET / not production. Hosted (bound secret) or production → OFF unless:
# DARFIX_ALLOW_MOCK_PAY=1
# MOYASAR_SECRET_KEY=
# MOYASAR_PUBLISHABLE_KEY=
# Shared secret for POST /api/payments/moyasar/webhook (Bearer or x-moyasar-webhook-secret).
# Required on hosted/pilot when Moyasar is enabled.
# MOYASAR_WEBHOOK_SECRET=

# Optional Tap Payments equivalents (adapter not wired yet — prefer Moyasar first):
# TAP_SECRET_KEY=
# TAP_PUBLISHABLE_KEY=
